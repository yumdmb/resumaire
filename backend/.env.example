# Copy these values into your shell, container config, or dotnet user-secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7263;http://localhost:5194
Cors__AllowedOrigins=http://localhost:5173
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=resumaire;Username=postgres;Password=postgres
Jwt__Issuer=resumaire-local
Jwt__Audience=resumaire-local
Jwt__SigningKey=replace-with-a-long-development-only-secret
OpenAI__ApiKey=replace-with-your-openai-api-key
